{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:monthly"],
  "timezone": "Asia/Tokyo",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "groupName": "barefootjs",
      "matchPackageNames": ["@barefootjs/**"]
    }
  ]
}

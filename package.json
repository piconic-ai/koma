{
  "name": "koma",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build-export-bundle.mjs && concurrently -k -n build,uno,server -c blue,magenta,green \"bun node_modules/@barefootjs/cli/dist/index.js build --watch\" \"unocss --watch\" \"bunx wrangler dev --live-reload\"",
    "build": "bun node_modules/@barefootjs/cli/dist/index.js build && unocss && bun scripts/build-export-bundle.mjs",
    "deploy": "bun node_modules/@barefootjs/cli/dist/index.js build && unocss && bun scripts/build-export-bundle.mjs && bunx wrangler deploy",
    "watch": "concurrently -k -n build,uno -c blue,magenta \"bun node_modules/@barefootjs/cli/dist/index.js build --watch\" \"unocss --watch\"",
    "build:export": "bun scripts/build-export-bundle.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@barefootjs/chart": "^0.1.3",
    "@barefootjs/cli": "^0.1.3",
    "@barefootjs/client": "^0.1.3",
    "@barefootjs/form": "^0.1.3",
    "@barefootjs/go-template": "^0.1.3",
    "@barefootjs/hono": "^0.1.3",
    "@barefootjs/jsx": "^0.1.3",
    "@barefootjs/mojolicious": "^0.1.3",
    "@barefootjs/shared": "^0.1.3",
    "@barefootjs/streaming": "^0.1.3",
    "@barefootjs/xyflow": "^0.1.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@barefootjs/test": "^0.1.3",
    "@types/bun": "latest",
    "shiki": "^4.1.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@unocss/cli": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "unocss": "^66.0.0"
  },
  "overrides": {
    "@barefootjs/cli": "^0.1.2",
    "@barefootjs/client": "^0.1.2",
    "@barefootjs/hono": "^0.1.2",
    "@barefootjs/jsx": "^0.1.2",
    "@barefootjs/shared": "^0.1.2",
    "@barefootjs/streaming": "^0.1.2",
    "@barefootjs/test": "^0.1.2",
    "@barefootjs/form": "^0.1.2",
    "@barefootjs/chart": "^0.1.2",
    "@barefootjs/xyflow": "^0.1.2",
    "@barefootjs/go-template": "^0.1.2",
    "@barefootjs/mojolicious": "^0.1.2"
  }
}

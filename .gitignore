# vite build outputs (regenerated by `vite build` / `vite dev`).
# `public/components/` holds the hashed client chunks; `dist/` holds the
# compiled SSR templates, which are never served over HTTP.
public/components/
dist/

# Playwright MCP scratch
.playwright-mcp/

# Wrangler local state (dev session, worker logs)
.wrangler/

# Dependencies
node_modules/

# UnoCSS output (regenerated by `unocss --watch` / `unocss`)
public/uno.css

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

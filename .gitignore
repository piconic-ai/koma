node_modules/

# UnoCSS output (regenerated by `unocss --watch` / `unocss`)
public/uno.css

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
